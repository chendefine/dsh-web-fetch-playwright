{
  "name": "dsh-web-fetch-playwright",
  "version": "0.1.0",
  "description": "Playwright/CDP web-fetch provider for DeepSeek Harness: renders pages in a real browser, denoises them (Readability + DOMPurify), and returns markdown.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json --emitDeclarationOnly && tsdown",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "playwright",
    "cdp",
    "web-fetch",
    "fetch-provider",
    "markdown",
    "bundle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chendefine/dsh-web-fetch-playwright.git"
  },
  "homepage": "https://github.com/chendefine/dsh-web-fetch-playwright#readme",
  "bugs": {
    "url": "https://github.com/chendefine/dsh-web-fetch-playwright/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": [
      "network:fetch (renders the URLs the user requests in a local browser)",
      "network:connect (user-configured CDP endpoint, default 127.0.0.1:9222)",
      "fs:read (user-configured playwright/browser executable path)"
    ],
    "jurisdiction": [],
    "retention": "none"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4",
    "@joplin/turndown-plugin-gfm": "^1.0.56",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.50.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.1",
    "@deepseek-ai/dsh-web": "0.1.1-rc.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
